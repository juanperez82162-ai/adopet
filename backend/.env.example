PORT=3000

ORACLE_USER=adopet
ORACLE_PASSWORD=
ORACLE_CONNECTION_STRING=localhost:1522/XEPDB1

UMBRAL_MATCH=60
DIAS_PROCESO_FORMAL=15
DIAS_RESPUESTA_CHECKPOINT=7

JWT_SECRETO=
JWT_EXPIRA=8h

# Dirección del frontend (para los enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# Correo saliente. Si CORREO_HOST queda vacío, los correos se muestran
# en la consola del backend en lugar de enviarse.
# Ejemplo con Gmail: CORREO_HOST=smtp.gmail.com, CORREO_PUERTO=587,
# CORREO_USUARIO=cuenta@gmail.com, CORREO_CONTRASENA=<contraseña de aplicación>
CORREO_HOST=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CONTRASENA=
CORREO_REMITENTE=ADOPET <no-responder@adopet.local>
